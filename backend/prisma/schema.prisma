generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  AGENT
  COMMERCANT
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String   @id @default(uuid())
  phone         String   @unique
  role          Role     @default(CLIENT)
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
